MYSQL_DATABASE=devvault
MYSQL_USER=devvault
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306
DB_POOL_SIZE=5
JPA_DDL_AUTO=update
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=관리자
APP_PORT=8080
FRONTEND_PORT=3000
DOMAIN=example.com
HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT_DIR=./nginx/certs
NGINX_MAX_BODY_SIZE=5121m

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=1209600000
OAUTH_EXCHANGE_CODE_EXPIRATION_MS=60000
PLAYBACK_TOKEN_EXPIRATION_MS=3600000

UPLOAD_DIR=./data/uploads
# true only when the edge Nginx mounts the uploads volume and defines /__devvault_files/
ACCEL_REDIRECT_ENABLED=false
MAX_FILE_SIZE=5GB
MAX_REQUEST_SIZE=5121MB
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_UPGRADE_URL=
